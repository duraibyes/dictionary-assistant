{
  "expo": {
    "name": "அகராதி Assistant",
    "slug": "eng-dictionary",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.duraibyes.dictionaryassistant"
    },
    "android": {
      "package": "com.duraibyes.dictionaryassistant",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-sqlite",
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Allow the app to use the microphone so you can speak a word.",
          "speechRecognitionPermission": "Allow speech recognition so the app can understand the word you say."
        }
      ],
      "expo-asset",
      "expo-secure-store",
      "expo-updates"
    ],
    "extra": {
      "eas": {
        "projectId": "ffa8174c-cff9-4a32-af7e-7099d690caac"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/ffa8174c-cff9-4a32-af7e-7099d690caac",
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    }
  }
}
